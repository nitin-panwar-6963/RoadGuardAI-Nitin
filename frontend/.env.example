# RoadGuard AI - Frontend Environment Config (Authentication layer only)
# Copy to frontend/.env.local (create this file; it is gitignored) and fill in your Supabase project's values.
# This is separate from backend/.env — the frontend never needs the
# Supabase service-role key, only the public anon key below.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings > API) — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Email domain allowed to sign in. Defaults to miet.ac.in if unset.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=miet.ac.in
